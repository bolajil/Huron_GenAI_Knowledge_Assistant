# ─────────────────────────────────────────────────────────────────────────────
# Huron GenAI — LOCAL DEMO environment file
#
# How to use:
#   cp backend/.env.demo backend/.env
#   # Fill in the Azure values from your free Azure portal
#   # Then start: uvicorn backend.main:app --port 8004 --reload
#
# NEVER commit backend/.env to git. It is in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development

# ── JWT (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
JWT_SECRET_KEY=REPLACE_WITH_GENERATED_SECRET

# ── Database (SQLite for local demo — no install needed) ──────────────────────
# Leave DATABASE_URL blank to use SQLite. Set it for PostgreSQL in staging/prod.
DATABASE_URL=
SQLITE_DB_PATH=backend/data/huron.db

# ── OpenAI / Azure OpenAI ─────────────────────────────────────────────────────
# Standard OpenAI:
OPENAI_API_KEY=sk-...your-key-here...
# Azure OpenAI (leave blank if using standard OpenAI):
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# ── Pinecone ──────────────────────────────────────────────────────────────────
PINECONE_API_KEY=your-pinecone-key
PINECONE_INDEX=huron-enterprise-knowledge
# Set to "faiss" for fully offline demo (no Pinecone account needed):
VECTOR_BACKEND=faiss

# ── Azure AD OIDC SSO ─────────────────────────────────────────────────────────
# Step-by-step to fill these in from portal.azure.com:
#
#  1. Go to Azure Active Directory → App registrations → New registration
#     Name: "Huron GenAI Demo"
#     Redirect URI (Web): http://localhost:8004/api/v1/auth/oidc/callback
#
#  2. After registering, copy:
#     - Application (client) ID  → OIDC_CLIENT_ID
#     - Directory (tenant) ID    → used in OIDC_AUTHORITY URL below
#
#  3. Certificates & secrets → New client secret → copy Value → OIDC_CLIENT_SECRET
#
#  4. Authentication → check "ID tokens" under Implicit grant
#
OIDC_CLIENT_ID=your-azure-app-client-id
OIDC_CLIENT_SECRET=your-azure-app-client-secret
OIDC_AUTHORITY=https://login.microsoftonline.com/your-tenant-id
OIDC_REDIRECT_URI=http://localhost:8004/api/v1/auth/oidc/callback
FRONTEND_URL=http://localhost:3000

# ── Azure Tenant (for Graph API / SharePoint real mode) ───────────────────────
# Same tenant ID as above. Only needed when SHAREPOINT_MOCK_MODE=false
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-azure-app-client-id
AZURE_CLIENT_SECRET=your-azure-app-client-secret

# ── Workday (set WORKDAY_MOCK_MODE=true for local demo) ───────────────────────
WORKDAY_MOCK_MODE=true
WORKDAY_BASE_URL=
WORKDAY_TENANT=
WORKDAY_CLIENT_ID=
WORKDAY_CLIENT_SECRET=

# ── SharePoint (set SHAREPOINT_MOCK_MODE=true for local demo) ─────────────────
SHAREPOINT_MOCK_MODE=true

# ── Microsoft Teams Bot (optional — use Bot Framework Emulator for local demo) ─
# Leave blank to skip; the emulator works without an App ID
TEAMS_APP_ID=
TEAMS_APP_SECRET=
# Internal URL the Teams bot uses to call the Huron chat API:
HURON_INTERNAL_API=http://localhost:8004

# ── Optional integrations ─────────────────────────────────────────────────────
REDIS_URL=
SENTRY_DSN=
MCP_ENCRYPTION_KEY=

# ── Slack / Email MCP tools (optional) ───────────────────────────────────────
SLACK_BOT_TOKEN=
SENDGRID_API_KEY=
